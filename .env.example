POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk_ai

SECRET_KEY=change-me

AI_PROVIDER=mock
OPENAI_API_KEY=

EMAIL_IMPORT_ENABLED=true
