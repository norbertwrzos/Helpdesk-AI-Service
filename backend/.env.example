APP_NAME=Helpdesk AI Service
APP_ENV=development
APP_DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

POSTGRES_DB=helpdesk_ai
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk_ai

SECRET_KEY=change-me

AI_PROVIDER=mock
AI_GENERATION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
